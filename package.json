{
  "name": "agileflow",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-agileflow-rules \"mocha rules-tests/*.test.js\"",
    "test:service": "firebase emulators:exec --only firestore,auth --project demo-agileflow-rules \"ng test --watch=false --browsers=ChromeHeadless --include=src/app/services/card.service.emulator.spec.ts\"",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-agileflow-local",
    "start:emulator": "ng serve --configuration emulator"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "firebase": "^12.16.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.32",
    "@angular/cli": "^20.3.32",
    "@angular/compiler-cli": "^20.3.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/jasmine": "~5.1.0",
    "firebase-tools": "^15.34.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "mocha": "^12.0.3",
    "typescript": "~5.9.2"
  }
}
